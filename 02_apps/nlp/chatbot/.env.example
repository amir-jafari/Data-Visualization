# Copy this file to .env and put your real keys THERE.
# This file is tracked by git -- never paste real credentials into it.
#
# These are AWS Bedrock credentials, separate from the S3 keys in s3/.env.
# Used by bedrock.py, which api_chatbot/ and agent_tools/ both import.
aws_access_key_id=
aws_secret_access_key=

# Required for temporary credentials (access keys starting with ASIA).
aws_session_token=

AWS_REGION=us-east-1

# Which Bedrock model to call. Leave as-is unless your account has a different
# model enabled -- check the Bedrock console for the exact inference-profile ID.
MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
