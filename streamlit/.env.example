# =============================================================================
# Copy this file to .env at the repo root and put your real keys THERE.
# This file is tracked by git -- never paste real credentials into it.
#
# Two different AWS accounts, using the SAME field names, told apart by the
# [tag] above each block -- the same format the AWS console hands you, so you
# can paste a block straight in without renaming anything.
#
#   [s3]       -> data + static assets for every Streamlit app
#   [bedrock]  -> the LLM behind the chatbot demos
#
# A key only ever belongs to the tag above it, so the two sets can never
# overwrite each other. Keep both tags, even if you only fill in one block.
# =============================================================================

[s3]
region=us-east-1
aws_access_key_id=
aws_secret_access_key=
# Required when the access key starts with ASIA (temporary STS credentials,
# e.g. AWS Academy / Learner Lab). Leave blank for long-term AKIA keys.
aws_session_token=

[bedrock]
region=us-east-1
aws_access_key_id=
aws_secret_access_key=
# Required when the access key starts with ASIA (temporary STS credentials).
aws_session_token=
# Which Bedrock model to call. Leave as-is unless your account has a different
# model enabled -- check the Bedrock console for the exact inference-profile ID.
model_id=us.anthropic.claude-sonnet-4-5-20250929-v1:0
